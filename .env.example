# CampusPilot 运行配置示例
# 复制为项目根目录的 .env 后填写；.env 不会提交到仓库。

# 真实模型（OpenAI 兼容接口）。三项都填写后，任务解析会优先调用真实模型。
# DeepSeek 示例：
#   CAMPUSPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
#   CAMPUSPILOT_LLM_API_KEY=sk-xxxxxxxx
#   CAMPUSPILOT_LLM_MODEL=deepseek-chat
CAMPUSPILOT_LLM_BASE_URL=
CAMPUSPILOT_LLM_API_KEY=
CAMPUSPILOT_LLM_MODEL=
CAMPUSPILOT_LLM_TIMEOUT=20

# 配送时间成本参数（示例估算用）
CAMPUSPILOT_SPEED_MPS=3.0
CAMPUSPILOT_CONGESTED_FACTOR=2.0
CAMPUSPILOT_SIM_SPEED_MPS=40.0
CAMPUSPILOT_DWELL_SECONDS=60

# 可插拔实时语义入口；0 关闭并使用原有人工上报/前端模拟流程。
# 仅作用于明确指定的模拟任务，不修改真实配送。运行一个后端 worker。
CAMPUSPILOT_SEMANTIC_BRIDGE=1
CAMPUSPILOT_SIM_TICK_INTERVAL=0.1
CAMPUSPILOT_SEMANTIC_MAX_AGE=30

# 可选：覆盖数据库与路网文件位置
# CAMPUSPILOT_DB=backend/var/campuspilot.db
# CAMPUSPILOT_MAP=backend/data/campus_map.json
